BROKER=mqtt.your.domain
MQTT_PORT=8883

MQTT_CAFILE=/etc/step/root_ca.crt
MQTT_CERT=/etc/mosquitto/certs/cert_monitor.crt
MQTT_KEY=/etc/mosquitto/certs/cert_monitor.key

TOPIC=homeassistant/sensor/homelab_certs

# Optional overrides (shown with defaults):
# CLIENT_ID=homelab-cert-monitor
# PUBLISH_INTERVAL_SEC=60
# ALERT_THRESHOLD_DAYS=7
# SYSTEMD_DIR=/etc/systemd/system
# CERTS=extra_service:/path/to/extra.crt
